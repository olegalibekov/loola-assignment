# Any OpenAI-compatible /chat/completions endpoint (vLLM, llama.cpp, OpenRouter, ...).
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=changeme
LLM_MODEL=your-model-name

# Optional knobs (defaults shown).
# CONTEXT_WINDOW=128000        # model window in tokens
# ENFORCE_WINDOW=0             # 1 = refuse to send prompts larger than the window (simulates a small n_ctx)
# MAX_OUTPUT_TOKENS=4096
# TOOL_MODE=dispatch           # eager | append | dispatch
# COMPACTION=1
# CAP_TOOL_OUTPUT=1
# MAX_API_ATTEMPTS=0           # 0 = unlimited; counts retries and compaction summaries
# MAX_WALL_SECONDS=0           # 0 = unlimited; cooperative deadline, not a hard watchdog
# LLM_EXTRA_BODY={}            # JSON merged into every request body (provider-specific options)
# LLM_TEMPERATURE=0.1          # set to `none` to omit it (current Claude models reject values below 1)
